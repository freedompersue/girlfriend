# ============================================
# 她在 AI Companion - 环境变量配置
# 上线前请将此文件复制为 .env 并填入真实值
# ============================================

# === 数据库 (Neon / Supabase / 其他 PostgreSQL) ===
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# === OpenRouter - LLM 聊天 ===
# 获取: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-xxx"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# 推荐模型: minimax/minimax-m1, google/gemini-2.5-flash, anthropic/claude-sonnet-4
LLM_MODEL="minimax/minimax-m1"

# === MiniMax - 图片生成 & TTS 语音 ===
# 获取: https://platform.minimaxi.com
# 如果不需要图片/语音功能，可以留空
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimaxi.com/v1"

# === 认证 ===
JWT_SECRET="生成一个强随机字符串-至少32字符"
BETTER_AUTH_SECRET="生成另一个强随机字符串-至少32字符"
# 生产环境必须使用公开访问的主域名，Google OAuth 回调也要使用同一个域名
BETTER_AUTH_URL="https://www.dreamgf.online"
AUTH_CANONICAL_URL="https://www.dreamgf.online"

# === Google OAuth (可选) ===
# 获取: https://console.cloud.google.com → OAuth 2.0 凭证
# Redirect URI: https://www.dreamgf.online/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# === GitHub OAuth (可选) ===
# 获取: https://github.com/settings/developers → OAuth App
# Callback URL: https://your-domain.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# === Creem 支付 (可选) ===
# 开发测试模式: https://docs.creem.io/getting-started/test-mode
# API Key / Webhook Secret: Dashboard -> Developers
CREEM_API_KEY="creem_test_xxx"
# 测试模式使用 https://test-api.creem.io，正式环境使用 https://api.creem.io
CREEM_BASE_URL="https://test-api.creem.io"
CREEM_WEBHOOK_SECRET=""

# 兼容旧的单一订阅商品配置；建议改为下面的细分商品 ID
CREEM_PRODUCT_ID=""

# 在 Creem Dashboard 创建商品后填入 Product ID
CREEM_PLUS_PRODUCT_ID=""
CREEM_PRO_PRODUCT_ID=""
CREEM_CREDITS_50_PRODUCT_ID=""
CREEM_CREDITS_200_PRODUCT_ID=""
CREEM_CREDITS_500_PRODUCT_ID=""

# === Telegram Bot (可选) ===
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# === QQ Bot (可选) ===
NEXT_PUBLIC_QQ_BOT_ID=""

# === Vercel Cron (可选) ===
CRON_SECRET="生成一个随机字符串用于保护cron端点"

# === 应用 ===
NEXT_PUBLIC_APP_NAME="她在"

# === 疗愈模式 ===
# Pro 专属功能；默认限时开放给所有用户。设为 false 后只允许 Pro 使用。
HEALING_FREE_TRIAL_OPEN="true"
