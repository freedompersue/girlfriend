generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  email           String?   @unique
  emailVerified   Boolean   @default(false)
  username        String?   @unique
  passwordHash    String?
  name            String?
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  selectedCharacterId String?
  selectedCharacter   Character? @relation(fields: [selectedCharacterId], references: [id])

  messages      Message[]
  profileItems  UserProfile[]
  affinity      Affinity[]
  checkIns      CheckIn[]
  notifications Notification[]
  moodEntries   MoodEntry[]
  milestones    Milestone[]
  externalLinks ExternalLink[]
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id            String   @id @default(cuid())
  expiresAt     DateTime
  token         String   @unique
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                  String   @id @default(cuid())
  accountId           String
  providerId          String
  accessToken         String?  @db.Text
  refreshToken        String?  @db.Text
  idToken             String?  @db.Text
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope               String?
  password            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model Character {
  id            String   @id @default(cuid())
  name          String   @unique
  subtitle      String
  tags          String[]
  description   String
  avatarUrl     String
  systemPrompt  String   @db.Text
  appearance    String   @db.Text
  baseImageUrl  String?
  voiceId       String?
  createdAt     DateTime @default(now())

  users         User[]
  messages      Message[]
  affinity      Affinity[]
  checkIns      CheckIn[]
  notifications Notification[]
  moodEntries   MoodEntry[]
  milestones    Milestone[]

  @@map("characters")
}

model Message {
  id          String   @id @default(cuid())
  role        String
  content     String   @db.Text
  imageUrl    String?
  audioUrl    String?
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([userId, characterId, createdAt])
  @@map("messages")
}

model UserProfile {
  id        String   @id @default(cuid())
  key       String
  value     String
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_profiles")
}

model Affinity {
  id        String   @id @default(cuid())
  score     Int      @default(50)
  level     Int      @default(1)
  updatedAt DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@map("affinities")
}

model CheckIn {
  id          String   @id @default(cuid())
  date        String
  streak      Int      @default(1)
  reward      Int      @default(0)
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId, date])
  @@index([userId, characterId, createdAt])
  @@map("check_ins")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  content   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String?
  character   Character? @relation(fields: [characterId], references: [id])

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model MoodEntry {
  id        String   @id @default(cuid())
  date      String
  score     Int
  label     String
  summary   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id])

  @@unique([userId, characterId, date])
  @@index([userId, date])
  @@map("mood_entries")
}

model Milestone {
  id          String   @id @default(cuid())
  type        String
  title       String
  content     String   @db.Text
  date        DateTime
  celebrated  Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String
  character   Character @relation(fields: [characterId], references: [id])

  @@unique([userId, characterId, type])
  @@map("milestones")
}

model ExternalLink {
  id          String   @id @default(cuid())
  platform    String
  externalId  String
  linkCode    String   @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@index([linkCode])
  @@map("external_links")
}
